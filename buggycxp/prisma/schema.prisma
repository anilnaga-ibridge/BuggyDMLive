generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model account_transactions {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  from_type       String    @db.VarChar(255)
  from_id         BigInt
  current_balance Decimal   @db.Decimal(24, 2)
  amount          Decimal   @db.Decimal(24, 2)
  method          String    @db.VarChar(255)
  ref             String?   @db.VarChar(255)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  type            String    @default("collected") @db.VarChar(20)
  created_by      String    @default("admin") @db.VarChar(20)
}

model add_ons {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name              String?
  price             Decimal   @default(0.00) @db.Decimal(24, 2)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  store_id          BigInt    @db.UnsignedBigInt
  status            Boolean   @default(true)
  addon_category_id BigInt?   @db.UnsignedBigInt
}

model addon_categories {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  module_id  BigInt?   @db.UnsignedBigInt
  status     Boolean   @default(true)
  slug       String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model addon_settings {
  id              String    @id @db.Char(36)
  key_name        String?
  live_values     String?   @db.LongText
  test_values     String?   @db.LongText
  settings_type   String?   @db.VarChar(255)
  mode            String    @default("live") @db.VarChar(20)
  is_active       Boolean   @default(true)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  additional_data String?   @db.LongText

  @@index([id], map: "payment_settings_id_index")
}

model admin_features {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String?   @db.VarChar(100)
  sub_title  String?   @db.VarChar(100)
  image      String?   @db.VarChar(100)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model admin_promotional_banners {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String?   @db.VarChar(100)
  sub_title  String?   @db.VarChar(100)
  image      String?   @db.VarChar(100)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model admin_roles {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(100)
  modules    String?   @db.Text
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model admin_special_criterias {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title      String?   @db.VarChar(100)
  image      String?   @db.VarChar(100)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model admin_testimonials {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name           String?   @db.VarChar(100)
  designation    String?   @db.VarChar(100)
  review         String?   @db.Text
  reviewer_image String?   @db.VarChar(255)
  company_image  String?   @db.VarChar(255)
  status         Boolean   @default(true)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
}

model admin_wallets {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  admin_id                 BigInt    @db.UnsignedBigInt
  total_commission_earning Decimal   @default(0.00) @db.Decimal(24, 2)
  digital_received         Decimal   @default(0.00) @db.Decimal(24, 2)
  manual_received          Decimal   @default(0.00) @db.Decimal(24, 2)
  created_at               DateTime? @db.Timestamp(0)
  updated_at               DateTime? @db.Timestamp(0)
  delivery_charge          Decimal   @default(0.000) @db.Decimal(24, 3)
}

model admins {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  f_name               String?   @db.VarChar(100)
  l_name               String?   @db.VarChar(100)
  phone                String?   @db.VarChar(20)
  email                String    @unique(map: "admins_email_unique") @db.VarChar(100)
  image                String?   @db.VarChar(100)
  password             String    @db.VarChar(100)
  remember_token       String?   @db.VarChar(100)
  created_at           DateTime? @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
  role_id              BigInt    @db.UnsignedBigInt
  zone_id              BigInt?   @db.UnsignedBigInt
  is_logged_in         Boolean   @default(true)
  login_remember_token String?   @db.VarChar(255)
  organization_id      BigInt?   @db.UnsignedBigInt
  department_id        BigInt?   @db.UnsignedBigInt
  designation          String?   @db.VarChar(100)
  shift_status         String    @default("Offline") @db.VarChar(50)
  device_binding_id    String?   @db.VarChar(100)

  // BuggyOPS back-references
  panel_pick_sessions       panel_pick_sessions[]
  panel_pack_sessions       panel_pack_sessions[]
  panel_qc_sessions         panel_qc_sessions[]
  panel_dispatch            panel_dispatch[]
  panel_rider_handover      panel_rider_handover[]
  panel_returns             panel_returns[]
  panel_order_workflows     panel_order_workflows[]
  panel_station_assignments panel_station_assignments[]
  panel_shift_logs          panel_shift_logs[]
  panel_scan_history        panel_scan_history[]
  reported_exceptions       panel_exception_logs[]      @relation("reported_exceptions")
  resolved_exceptions       panel_exception_logs[]      @relation("resolved_exceptions")
}

model advertisements {
  id                BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  store_id          BigInt                  @db.UnsignedBigInt
  module_id         BigInt?                 @db.UnsignedBigInt
  module_type       String?                 @db.VarChar(255)
  add_type          advertisements_add_type @default(store_promotion)
  title             String?                 @db.VarChar(255)
  description       String?                 @db.Text
  start_date        DateTime                @db.Date
  end_date          DateTime                @db.Date
  pause_note        String?                 @db.Text
  cancellation_note String?                 @db.Text
  cover_image       String?                 @db.VarChar(255)
  profile_image     String?                 @db.VarChar(255)
  video_attachment  String?                 @db.VarChar(255)
  priority          Int?
  is_rating_active  Boolean                 @default(false)
  is_review_active  Boolean                 @default(false)
  is_paid           Boolean                 @default(false)
  is_updated        Boolean                 @default(false)
  created_by_id     BigInt                  @db.UnsignedBigInt
  created_by_type   String                  @db.VarChar(255)
  status            advertisements_status   @default(pending)
  created_at        DateTime?               @db.Timestamp(0)
  updated_at        DateTime?               @db.Timestamp(0)
}

model allergies {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  allergy    String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model allergy_item {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  item_id    BigInt @db.UnsignedBigInt
  allergy_id BigInt @db.UnsignedBigInt
}

model allergy_item_campaign {
  id               BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  item_campaign_id BigInt @db.UnsignedBigInt
  allergy_id       BigInt @db.UnsignedBigInt
}

model analytic_scripts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  type       String?   @db.VarChar(255)
  script_id  String?   @db.Text
  script     String?   @db.LongText
  is_active  Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model attributes {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(100)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model automated_messages {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  message      String?   @db.VarChar(255)
  status       Boolean   @default(true)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  question     String    @db.VarChar(255)
  question_for String    @default("customer") @db.VarChar(255)
}

model banners {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title        String?   @db.VarChar(255)
  type         String    @db.VarChar(255)
  image        String?   @db.VarChar(255)
  status       Boolean   @default(true)
  data         String    @db.VarChar(255)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  zone_id      BigInt    @db.UnsignedBigInt
  module_id    BigInt    @db.UnsignedBigInt
  featured     Boolean   @default(false)
  default_link String?   @db.VarChar(255)
  created_by   String    @default("admin") @db.VarChar(255)
  modules      modules   @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "banners_module_id_foreign")

  @@index([module_id], map: "banners_module_id_foreign")
}

model brands {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  slug       String?   @db.VarChar(255)
  image      String?   @db.VarChar(100)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  module_id  Int?
}

model business_settings {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key        String    @db.VarChar(255)
  value      String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model campaign_store {
  campaign_id     BigInt    @db.UnsignedBigInt
  store_id        BigInt    @db.UnsignedBigInt
  campaign_status String?   @default("pending") @db.VarChar(10)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@ignore
}

model campaigns {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title       String?
  image       String?   @db.VarChar(100)
  description String?   @db.Text
  status      Boolean   @default(true)
  admin_id    BigInt?   @db.UnsignedBigInt
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  start_date  DateTime? @db.Date
  end_date    DateTime? @db.Date
  start_time  DateTime? @db.Time(0)
  end_time    DateTime? @db.Time(0)
  module_id   BigInt    @db.UnsignedBigInt
  slug        String?   @db.VarChar(255)
  modules     modules   @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "campaigns_module_id_foreign")

  @@index([module_id], map: "campaigns_module_id_foreign")
}

model carts {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt    @db.UnsignedBigInt
  module_id   BigInt    @db.UnsignedBigInt
  store_id    BigInt?   @db.UnsignedBigInt
  item_id     BigInt    @db.UnsignedBigInt
  reel_id     BigInt?   @db.UnsignedBigInt
  is_guest    Boolean   @default(false)
  add_on_ids  String?   @db.Text
  add_on_qtys String?   @db.Text
  item_type   String    @db.VarChar(255)
  price       Float
  quantity    Int
  variation   String?   @db.Text
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  stores      stores?   @relation(fields: [store_id], references: [id], onUpdate: NoAction, map: "carts_store_id_foreign")

  @@index([reel_id], map: "carts_reel_id_index")
  @@index([store_id], map: "carts_store_id_foreign")
}

model cash_back_histories {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  cash_back_id      BigInt?   @db.UnsignedBigInt
  order_id          BigInt?   @db.UnsignedBigInt
  user_id           BigInt?   @db.UnsignedBigInt
  cashback_type     String    @db.VarChar(255)
  calculated_amount Float     @default(0.000)
  cashback_amount   Float     @default(0.000)
  min_purchase      Float     @default(0.000)
  max_discount      Float     @default(0.000)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  trip_id           BigInt?   @db.UnsignedBigInt
}

model cash_backs {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title           String    @db.VarChar(255)
  customer_id     String?   @default("[\"all\"]") @db.VarChar(255)
  cashback_type   String    @db.VarChar(255)
  same_user_limit Int       @default(1)
  total_used      Int       @default(0)
  cashback_amount Float     @default(0.000)
  min_purchase    Float     @default(0.000)
  max_discount    Float     @default(0.000)
  start_date      DateTime? @db.Date
  end_date        DateTime? @db.Date
  status          Boolean   @default(true)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  is_rental       Boolean   @default(false)
}

model categories {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String
  image      String    @default("def.png") @db.VarChar(255)
  parent_id  Int
  position   Int
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  priority   Int       @default(0)
  module_id  BigInt    @db.UnsignedBigInt
  slug       String?   @db.VarChar(255)
  featured   Boolean   @default(false)
  modules    modules   @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "categories_module_id_foreign")

  @@index([module_id], map: "categories_module_id_foreign")
  @@index([name], map: "categories_name_index")
  @@index([parent_id], map: "categories_parent_id_index")
}

model categories_sub {
  id           Int       @id @default(autoincrement())
  cat_name     String    @db.Text
  parentcat_id Int?
  cat_slug     String?   @db.VarChar(250)
  created_at   DateTime? @db.DateTime(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model common_conditions {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  slug       String?   @db.VarChar(255)
  status     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model contacts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(100)
  email      String    @db.VarChar(100)
  subject    String    @db.Text
  message    String    @db.Text
  seen       Int       @default(0) @db.TinyInt
  feedback   String    @default("0") @db.VarChar(255)
  reply      String?   @db.LongText
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model conversations {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sender_id            BigInt    @db.UnsignedBigInt
  sender_type          String    @db.VarChar(255)
  receiver_id          BigInt    @db.UnsignedBigInt
  receiver_type        String    @db.VarChar(255)
  last_message_id      BigInt?   @db.UnsignedBigInt
  last_message_time    DateTime? @db.Timestamp(0)
  unread_message_count Int       @default(0)
  created_at           DateTime? @db.Timestamp(0)
  updated_at           DateTime? @db.Timestamp(0)
}

model coupons {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title         String?
  code          String?   @unique(map: "coupons_code_unique") @db.VarChar(100)
  start_date    DateTime? @db.Date
  expire_date   DateTime? @db.Date
  min_purchase  Decimal   @default(0.00) @db.Decimal(24, 2)
  max_discount  Decimal   @default(0.00) @db.Decimal(24, 2)
  discount      Decimal   @default(0.00) @db.Decimal(24, 2)
  discount_type String    @default("percentage") @db.VarChar(15)
  coupon_type   String    @default("default") @db.VarChar(255)
  limit         Int?
  status        Boolean   @default(true)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  data          String?   @db.VarChar(255)
  total_uses    BigInt?   @default(0)
  module_id     BigInt    @db.UnsignedBigInt
  created_by    String?   @default("admin") @db.VarChar(50)
  customer_id   String?   @default("[\"all\"]") @db.VarChar(255)
  slug          String?   @db.VarChar(255)
  store_id      BigInt?   @db.UnsignedBigInt
  modules       modules   @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "coupons_module_id_foreign")

  @@index([module_id], map: "coupons_module_id_foreign")
}

model currencies {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  country         String?   @db.VarChar(255)
  currency_code   String?   @db.VarChar(255)
  currency_symbol String?   @db.VarChar(255)
  exchange_rate   Decimal?  @db.Decimal(8, 2)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model customer_addresses {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  address_type          String    @db.VarChar(100)
  contact_person_number String    @db.VarChar(20)
  address               String?   @db.Text
  latitude              String?   @db.VarChar(255)
  longitude             String?   @db.VarChar(255)
  user_id               BigInt?   @db.UnsignedBigInt
  contact_person_name   String?   @db.VarChar(100)
  created_at            DateTime? @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  zone_id               BigInt    @db.UnsignedBigInt
  floor                 String?   @db.VarChar(255)
  road                  String?   @db.VarChar(255)
  house                 String?   @db.VarChar(255)
}

model d_m_reviews {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  delivery_man_id BigInt    @db.UnsignedBigInt
  user_id         BigInt    @db.UnsignedBigInt
  order_id        BigInt    @db.UnsignedBigInt
  comment         String?   @db.MediumText
  attachment      String?   @db.VarChar(255)
  rating          Int       @default(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  status          Boolean?  @default(true)
}

model d_m_vehicles {
  id                     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type                   String    @db.VarChar(255)
  starting_coverage_area Float
  maximum_coverage_area  Float
  extra_charges          Float
  status                 Boolean   @default(false)
  created_at             DateTime? @db.Timestamp(0)
  updated_at             DateTime? @db.Timestamp(0)
  description            String?   @db.Text
  image                  String?   @db.VarChar(255)
  is_delivery            Boolean   @default(true)
  is_ride                Boolean   @default(false)
  name                   String?   @db.VarChar(255)
}

model data_settings {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key        String?   @db.VarChar(255)
  value      String?   @db.Text
  type       String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model delivery_histories {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  order_id        BigInt?   @db.UnsignedBigInt
  delivery_man_id BigInt?   @db.UnsignedBigInt
  time            DateTime? @db.DateTime(0)
  longitude       String?   @db.VarChar(255)
  latitude        String?   @db.VarChar(255)
  location        String?   @db.VarChar(255)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([delivery_man_id], map: "delivery_histories_delivery_man_id_index")
}

model delivery_man_wallets {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  delivery_man_id  BigInt    @db.UnsignedBigInt
  collected_cash   Decimal   @default(0.00) @db.Decimal(24, 2)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  total_earning    Decimal   @default(0.00) @db.Decimal(24, 2)
  total_withdrawn  Decimal   @default(0.00) @db.Decimal(24, 2)
  pending_withdraw Decimal   @default(0.00) @db.Decimal(24, 2)

  @@index([delivery_man_id], map: "delivery_man_wallets_delivery_man_id_index")
}

model delivery_men {
  id                   BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  f_name               String?                         @db.VarChar(100)
  l_name               String?                         @db.VarChar(100)
  phone                String                          @unique(map: "delivery_men_phone_unique") @db.VarChar(20)
  email                String?                         @db.VarChar(100)
  identity_number      String?                         @db.VarChar(30)
  identity_type        String?                         @db.VarChar(50)
  identity_image       String                          @db.Text
  image                String?                         @db.VarChar(100)
  password             String                          @db.VarChar(100)
  auth_token           String?                         @db.VarChar(255)
  fcm_token            String?                         @db.VarChar(255)
  zone_id              BigInt?
  created_at           DateTime?                       @db.Timestamp(0)
  updated_at           DateTime?                       @db.Timestamp(0)
  status               Boolean                         @default(true)
  active               Boolean                         @default(true)
  earning              Boolean                         @default(true)
  current_orders       Int                             @default(0)
  type                 String                          @default("zone_wise")
  store_id             BigInt?
  application_status   delivery_men_application_status @default(approved)
  order_count          Int                             @default(0) @db.UnsignedInt
  assigned_order_count Int                             @default(0) @db.UnsignedInt
  vehicle_id           BigInt?                         @db.UnsignedBigInt
  is_delivery          Boolean                         @default(true)
  is_ride              Boolean                         @default(false)
  loyalty_point        Float?                          @default(0)
  ref_by               BigInt?                         @db.UnsignedBigInt
  ref_code             String?                         @db.VarChar(255)

  // Extended QCOM columns
  vehicle_type      String?   @default("bike") @db.VarChar(50)
  max_active_orders Int?      @default(2)
  max_volume_cm3    Float?    @default(30000.0)
  shift_status      String?   @default("Offline") @db.VarChar(50)
  latitude          Float?
  longitude         Float?
  last_ping_at      DateTime? @db.Timestamp(0)
  rating            Float?    @default(5.0)

  // BuggyOPS back-references
