  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  tokens  qcos_design_tokens[]
  layouts qcos_layouts[]

  @@map("qcos_themes")
}

model qcos_design_tokens {
  id          Int      @id @default(autoincrement())
  theme_id    Int
  token_key   String   @db.VarChar(100)
  token_value String   @db.Text
  category    String   @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamp(0)

  theme qcos_themes @relation(fields: [theme_id], references: [id], onDelete: Cascade)

  @@index([theme_id])
  @@index([token_key])
  @@map("qcos_design_tokens")
}

model qcos_media_library {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  file_type       String   @db.VarChar(50)
  url             String   @db.VarChar(512)
  responsive_urls String?  @db.Text
  size_bytes      Int
  mime_type       String   @db.VarChar(100)
  width           Int?
  height          Int?
  alt_text        String?  @db.VarChar(255)
  checksum_sha256 String?  @db.Char(64)
  status          String   @default("active") @db.VarChar(30)
  created_by      Int?
  created_at      DateTime @default(now()) @db.Timestamp(0)

  @@map("qcos_media_library")
}

model qcos_page_templates {
  id          Int      @id @default(autoincrement())
  page_name   String   @unique @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)

  versions qcos_page_versions[]

  @@map("qcos_page_templates")
}

model qcos_page_versions {
  id             Int       @id @default(autoincrement())
  template_id    Int
  version_number Int
  status         String    @default("draft") @db.VarChar(50)
  created_by     Int
  approved_by    Int?
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  published_at   DateTime? @db.Timestamp(0)

  template     qcos_page_templates           @relation(fields: [template_id], references: [id], onDelete: Cascade)
  layouts      qcos_layouts[]
  diffs        qcos_diff_versions[]
  publish_logs qcos_publish_history[]
  schedules    qcos_scheduled_publications[]

  @@index([template_id])
  @@map("qcos_page_versions")
}

model qcos_layouts {
  id              Int     @id @default(autoincrement())
  page_version_id Int
  theme_id        Int?
  name            String  @db.VarChar(100)
  is_enabled      Boolean @default(true)

  page_version qcos_page_versions @relation(fields: [page_version_id], references: [id], onDelete: Cascade)
  theme        qcos_themes?       @relation(fields: [theme_id], references: [id], onDelete: SetNull)
  sections     qcos_sections[]

  @@index([page_version_id])
  @@index([theme_id])
  @@map("qcos_layouts")
}

model qcos_sections {
  id               Int     @id @default(autoincrement())
  layout_id        Int
  name             String  @db.VarChar(100)
  display_order    Int
  visibility_rules String? @db.Text
  constraints_json String? @db.Text

  layout  qcos_layouts            @relation(fields: [layout_id], references: [id], onDelete: Cascade)
  widgets qcos_widget_instances[]

  @@index([layout_id])
  @@map("qcos_sections")
}

model qcos_widgets {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  schema_def  String   @db.Text
  min_version String   @db.VarChar(20)
  max_version String?  @db.VarChar(20)
  fallback_id Int?
  created_at  DateTime @default(now()) @db.Timestamp(0)

  instances qcos_widget_instances[]

  @@map("qcos_widgets")
}

model qcos_widget_instances {
  id              Int    @id @default(autoincrement())
  section_id      Int
  widget_id       Int
  display_order   Int
  properties_json String @db.Text
  data_source_id  Int?

  section     qcos_sections            @relation(fields: [section_id], references: [id], onDelete: Cascade)
  widget      qcos_widgets             @relation(fields: [widget_id], references: [id], onDelete: Cascade)
  data_source qcos_data_sources?       @relation(fields: [data_source_id], references: [id], onDelete: SetNull)
  actions     qcos_widget_actions[]
  conditions  qcos_widget_conditions[]
  analytics   qcos_analytics_events[]

  @@index([section_id])
  @@index([widget_id])
  @@index([data_source_id])
  @@map("qcos_widget_instances")
}

model qcos_data_sources {
  id                Int      @id @default(autoincrement())
  name              String   @unique @db.VarChar(100)
  resolver_endpoint String   @db.VarChar(255)
  filters_json      String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamp(0)

  instances qcos_widget_instances[]

  @@map("qcos_data_sources")
}

model qcos_widget_actions {
  id                 Int    @id @default(autoincrement())
  widget_instance_id Int
  trigger            String @db.VarChar(50)
  action_type        String @db.VarChar(100)
  params_json        String @db.Text

  widget_instance qcos_widget_instances @relation(fields: [widget_instance_id], references: [id], onDelete: Cascade)

  @@index([widget_instance_id])
  @@map("qcos_widget_actions")
}

model qcos_widget_conditions {
  id                 Int    @id @default(autoincrement())
  widget_instance_id Int
  condition_expr     String @db.Text

  widget_instance qcos_widget_instances @relation(fields: [widget_instance_id], references: [id], onDelete: Cascade)

  @@index([widget_instance_id])
  @@map("qcos_widget_conditions")
}

model qcos_experience_context {
  id                   Int      @id @default(autoincrement())
  user_id              BigInt   @unique @db.UnsignedBigInt
  city                 String?  @db.VarChar(100)
  timezone             String   @default("UTC") @db.VarChar(50)
  device_type          String   @default("mobile") @db.VarChar(50)
  network_speed        String?  @db.VarChar(20)
  preferred_categories String?  @db.Text
  weather_code         String?  @db.VarChar(50)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("qcos_experience_context")
}

model qcos_feature_flags {
  id          Int      @id @default(autoincrement())
  flag_key    String   @unique @db.VarChar(100)
  description String?  @db.Text
  is_enabled  Boolean  @default(false)
  rules_json  String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  experiments qcos_experiments[]

  @@map("qcos_feature_flags")
}

model qcos_experiments {
  id          Int      @id @default(autoincrement())
  flag_id     Int
  name        String   @db.VarChar(100)
  description String?  @db.Text
  status      String   @default("draft") @db.VarChar(50)
  starts_at   DateTime @db.Timestamp(0)
  ends_at     DateTime @db.Timestamp(0)
  created_at  DateTime @default(now()) @db.Timestamp(0)

  flag     qcos_feature_flags         @relation(fields: [flag_id], references: [id], onDelete: Cascade)
  variants qcos_experiment_variants[]

  @@index([flag_id])
  @@map("qcos_experiments")
}

model qcos_experiment_variants {
  id              Int     @id @default(autoincrement())
  experiment_id   Int
  name            String  @db.VarChar(50)
  traffic_pct     Decimal @db.Decimal(5, 2)
  properties_json String  @db.Text

  experiment qcos_experiments @relation(fields: [experiment_id], references: [id], onDelete: Cascade)

  @@index([experiment_id])
  @@map("qcos_experiment_variants")
}

model qcos_experience_rules {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  conditions_json String   @db.Text
  actions_json    String   @db.Text
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(0)

  @@map("qcos_experience_rules")
}

model qcos_release_channels {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)
  code String @unique @db.VarChar(20)

  publish_logs qcos_publish_history[]
  schedules    qcos_scheduled_publications[]

  @@map("qcos_release_channels")
}

model qcos_publish_history {
  id              Int       @id @default(autoincrement())
  page_version_id Int
  channel_id      Int
  published_by    Int
  published_at    DateTime  @default(now()) @db.Timestamp(0)
  rolled_back_at  DateTime? @db.Timestamp(0)
  rollout_pct     Decimal   @default(100.00) @db.Decimal(5, 2)
  publish_reason  String?   @db.VarChar(500)

  page_version qcos_page_versions    @relation(fields: [page_version_id], references: [id], onDelete: Cascade)
  channel      qcos_release_channels @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@index([page_version_id])
  @@index([channel_id])
  @@map("qcos_publish_history")
}

model qcos_diff_versions {
  id              Int      @id @default(autoincrement())
  page_version_id Int
  version_hash    String   @unique @db.VarChar(64)
  diff_payload    String   @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(0)

  page_version qcos_page_versions @relation(fields: [page_version_id], references: [id], onDelete: Cascade)

  @@index([page_version_id])
  @@map("qcos_diff_versions")
}

model qcos_audit_logs {
  id           Int      @id @default(autoincrement())
  user_id      Int
  action       String   @db.VarChar(100)
  target_table String   @db.VarChar(100)
  record_id    Int
  old_value    String?  @db.Text
  new_value    String?  @db.Text
  ip_address   String   @db.VarChar(45)
  user_agent   String   @db.VarChar(255)
  timestamp    DateTime @default(now()) @db.Timestamp(0)

  @@map("qcos_audit_logs")
}

model qcos_analytics_events {
  id                 Int      @id @default(autoincrement())
  widget_instance_id Int
  event_name         String   @db.VarChar(100)
  metric_key         String?  @db.VarChar(100)
  created_at         DateTime @default(now()) @db.Timestamp(0)

  widget_instance qcos_widget_instances @relation(fields: [widget_instance_id], references: [id], onDelete: Cascade)

  @@index([widget_instance_id])
  @@map("qcos_analytics_events")
}

model qcos_localizations {
  id          Int      @id @default(autoincrement())
  entity_type String   @db.VarChar(50)
  entity_id   Int
  locale      String   @db.VarChar(35)
  field_key   String   @db.VarChar(100)
  value_text  String   @db.Text
  status      String   @default("draft") @db.VarChar(30)
  created_by  Int
  approved_by Int?
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([entity_type, entity_id, locale, field_key], map: "qcos_localizations_entity_locale_field_unique")
  @@index([locale, status])
  @@map("qcos_localizations")
}

model qcos_segments {
  id          Int      @id @default(autoincrement())
  segment_key String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  rules_json  String   @db.Text
  is_active   Boolean  @default(true)
  created_by  Int
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("qcos_segments")
}

model qcos_scheduled_publications {
  id              Int       @id @default(autoincrement())
  page_version_id Int
  channel_id      Int
  scheduled_for   DateTime  @db.Timestamp(0)
  rollout_pct     Decimal   @default(100.00) @db.Decimal(5, 2)
  status          String    @default("scheduled") @db.VarChar(30)
  reason          String    @db.VarChar(500)
  created_by      Int
  executed_at     DateTime? @db.Timestamp(0)
  cancelled_at    DateTime? @db.Timestamp(0)
  created_at      DateTime  @default(now()) @db.Timestamp(0)

  page_version qcos_page_versions    @relation(fields: [page_version_id], references: [id], onDelete: Cascade)
  channel      qcos_release_channels @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@index([status, scheduled_for])
  @@index([page_version_id, channel_id])
  @@map("qcos_scheduled_publications")
}

model qcos_role_permissions {
  id         Int      @id @default(autoincrement())
  role_id    BigInt   @db.UnsignedBigInt
  permission String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@unique([role_id, permission], map: "qcos_role_permissions_role_permission_unique")
  @@index([permission])
  @@map("qcos_role_permissions")
}
