# Copy to .env for local development. Never commit populated credentials.
DATABASE_URL="mysql://buggydm_user:change-me@127.0.0.1:3306/buggydm"
SESSION_SECRET="replace-with-at-least-32-random-bytes"

NEXT_PUBLIC_APP_URL="http://localhost:3000/BuggyDm"
NEXT_PUBLIC_IMAGE_BASE_URL="http://localhost:8888/BuggyMD/Buggy/public/storage/product"

# Leave REDIS_HOST empty only when intentionally using the non-Redis fallback.
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
