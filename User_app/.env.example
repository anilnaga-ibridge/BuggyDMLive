# ==============================================================================
# BUGGY USER APP (FLUTTER) ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace the placeholder values with your real keys.
# ==============================================================================

# 1. APPLICATION DETAILS
APP_NAME="Buggy"
APP_DISPLAY_NAME="Buggy"
APP_VERSION="4.1"
APP_ENV="local"
APP_MODE="live"
PACKAGE_NAME="com.sixamtech.sixam_mart_user"

# 2. BACKEND & API CONFIGURATION
BASE_URL="http://127.0.0.1:8000"
API_BASE_URL="http://127.0.0.1:8000/api/v1"
WEB_HOSTED_URL="https://6ammart-react.6amtech.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BUGGYDM_BASE_URL="http://localhost:3000/BuggyDm"
BUGGYCXP_BASE_URL="http://localhost:3001/BuggyCxp"
IMAGE_BASE_URL="http://127.0.0.1:8000/storage"

# 3. DATABASE (MATCHING LARAVEL BACKEND / MAMP)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT="8889"
DB_DATABASE="BuggyDelivery"
DB_USERNAME="root"
DB_PASSWORD="root"

# 4. REDIS & CACHE CONFIGURATION
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=null

# 5. GOOGLE MAPS & LOCATION SERVICES
GOOGLE_MAPS_WEB_API_KEY="YOUR_GOOGLE_MAPS_WEB_API_KEY"
GOOGLE_MAPS_ANDROID_API_KEY="YOUR_GOOGLE_MAPS_ANDROID_API_KEY"
GOOGLE_MAPS_IOS_API_KEY="YOUR_GOOGLE_MAPS_IOS_API_KEY"
DEFAULT_LATITUDE="17.452462652941296"
DEFAULT_LONGITUDE="78.38770715453175"
DEFAULT_ZONE_ID=2

# 6. AUTHENTICATION & GOOGLE SIGN-IN
GOOGLE_SERVER_CLIENT_ID="YOUR_GOOGLE_SERVER_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_ANDROID_CLIENT_ID="YOUR_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com"

# 7. FIREBASE & PUSH NOTIFICATIONS
FIREBASE_PROJECT_NUMBER="YOUR_FIREBASE_PROJECT_NUMBER"
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
FCM_TOPIC="all_zone_customer"

# Android Firebase
FIREBASE_ANDROID_API_KEY="YOUR_FIREBASE_ANDROID_API_KEY"
FIREBASE_ANDROID_APP_ID="1:000000000000:android:0000000000000000000000"

# Web Firebase
FIREBASE_WEB_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_WEB_APP_ID="1:000000000000:web:0000000000000000000000"
FIREBASE_WEB_AUTH_DOMAIN="your-project.firebaseapp.com"

# iOS Firebase
FIREBASE_IOS_API_KEY="YOUR_FIREBASE_IOS_API_KEY"
FIREBASE_IOS_APP_ID="1:000000000000:ios:0000000000000000000000"

# 7b. FACEBOOK / META CREDENTIALS
FACEBOOK_APP_ID="YOUR_FACEBOOK_APP_ID"
FACEBOOK_CLIENT_TOKEN="YOUR_FACEBOOK_CLIENT_TOKEN"

# 8. REAL-TIME BROADCASTING & PUSHER / WEBSOCKETS
PUSHER_APP_ID=""
PUSHER_APP_KEY=""
PUSHER_APP_SECRET=""
PUSHER_APP_CLUSTER="mt1"
PUSHER_BROADCAST_AUTH_URL="/api/v1/broadcasting/user-auth"

# 9. PAYMENT & GATEWAYS
PAY_IN_WEBVIEW=false
SNAPMINT_ENABLED=true
WALLET_MIN_INPUT_LENGTH=10

# 10. LICENSE & ACTIVATION
PURCHASE_CODE=""
BUYER_USERNAME=""
SOFTWARE_ID=""
SOFTWARE_VERSION="4.0.1"
